#!/bin/sh

set -euo pipefail

function docker_run() {
  docker run \
    --rm \
    --mount type=bind,src=./config,dst=/workspaces/config,readonly \
    --mount type=bind,src=./firmware,dst=/workspaces/firmware,bind-create-src \
    --mount type=bind,src=./images,dst=/workspaces/images \
    zmk-config "$@"
}

mode="f"

while getopts "dfi" opt; do
  case ${opt} in
    *) mode=${opt} ;;
  esac
done

case ${mode} in
  d)
    docker_run draw -k cradio
    open images/cradio.svg
    ;;

  f)
    docker_run build -b nice_nano_v2 -s cradio_left
    docker_run build -b nice_nano_v2 -s cradio_right
    open firmware
    ;;

  i)
    docker build --tag zmk-config .
    ;;
esac
