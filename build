#!/bin/bash

set -euo pipefail

usage() {
  cat <<-END
usage: build [-I] firmware [-k <keyboard>]
       build [-I] keymap [-k <keyboard>]
       build [-I] shell

  global options:
    -I             build docker image

  commands:
    firmware       build keyboard firmware (default)
    keymap         draw keyboard keymap
    shell          start an interactive shell in the docker container

  options:
    -k <keyboard>  select keyboard

  keyboards:
    ferris_sweep (default)
    corne_min

END
}

docker_run() {
  build=$(mktemp -d -t zmk-config)

  if [ -z "${1+x}" ]; then
    local tty="--tty"
  fi

  docker run --rm --env build=/app/build --interactive ${tty:-} \
    --mount type=bind,src=${build},dst=/app/build \
    --mount type=bind,src=./config,dst=/app/config,readonly \
    --mount type=bind,src=./firmware,dst=/app/firmware,bind-create-src \
    --mount type=bind,src=./img,dst=/app/img \
    zmk-config "$@"
}

west() {
  docker_run west "$@"
}

keymap() {
  docker_run keymap "$@"
}

while getopts "I" opt; do
  case ${opt} in
    I) docker build --tag zmk-config . ;;
   \?) usage; exit 1 ;;
  esac
done

shift $((OPTIND-1))
command=${1:-default}
shift||
OPTIND=1

case ${command} in
  firmware|default)
    while getopts "k:" opt; do
      case ${opt} in
        k) keyboard=${OPTARG} ;;
       \?) usage; exit 1 ;;
      esac
    done

    case ${keyboard:-default} in
      ferris_sweep|default)
        west build -s zmk/app -d /app/build -b nice_nano_v2 -- -DZMK_CONFIG=/app/config -DSHIELD=cradio_left
        cp ${build}/zephyr/zmk.uf2 firmware/ferris_sweep-left.uf2
        west build -s zmk/app -d /app/build -b nice_nano_v2 -- -DZMK_CONFIG=/app/config -DSHIELD=cradio_right
        cp ${build}/zephyr/zmk.uf2 firmware/ferris_sweep-right.uf2
        open -R firmware/ferris_sweep-left.uf2
        ;;
      corne_min)
        west build -s zmk/app -d /app/build -b corne_min_left -- -DZMK_CONFIG=/app/config -DSHIELD=rgbled_adapter
        cp ${build}/zephyr/zmk.uf2 firmware/corne_min-left.uf2
        west build -s zmk/app -d /app/build -b corne_min_right -- -DZMK_CONFIG=/app/config -DSHIELD=rgbled_adapter
        cp ${build}/zephyr/zmk.uf2 firmware/corne_min-right.uf2
        open -R firmware/corne_min-left.uf2
        ;;
      *)
        echo "${0}: unrecognized keyboard -- ${keyboard}"
        usage
        exit 1
        ;;
    esac

    ;;

  keymap)
    while getopts "k:" opt; do
      case ${opt} in
        k) keyboard=${OPTARG} ;;
       \?) usage; exit 1 ;;
      esac
    done

    case ${keyboard:-default} in
      ferris_sweep|default)
        keymap -c config/keymap-drawer.yml parse -z config/cradio.keymap \
          | keymap -c config/keymap-drawer.yml draw -o img/cradio.svg -
        open img/cradio.svg
        ;;
      corne_min)
        keymap -c config/keymap-drawer.yml parse -z config/corne_min.keymap \
          | keymap -c config/keymap-drawer.yml draw -d zmk/app/dts/layouts/foostan/corne/6column.dtsi -o img/corne_min.svg -
        open img/corne_min.svg
        ;;
      *)
        echo "${0}: unrecognized keyboard -- ${keyboard}"
        usage
        exit 1
        ;;
    esac
    ;;

  shell)
    # NOTE(mt): All the unnecessary-looking Docker bind mounts above, the cute
    # west and keymap wrappers around docker run, the awkward dependency on the
    # side-effecty $build global variable, and all the seeming duplication of
    # commands in the case statements, actually work together beautifully:
    #
    # Their interrelationships mean that any docker-using commands in this
    # script can be copy-pasted directly into a docker container shell and run
    # unmodified!
    #
    # I imagine this is going to be super nice for both iterating on new
    # settings and fixing any problems live, then easily codifying my learnings
    # back in this script!
    docker_run
    ;;

  *)
    echo "${0}: unrecognized command -- ${command}"
    usage
    exit 1
    ;;

esac
