#!/bin/bash

set -euo pipefail

DOCKER_MOUNTS=(
  --mount type=bind,src=./config,dst=/app/config,readonly
  --mount type=bind,src=./firmware,dst=/app/out/firmware,bind-create-src
  --mount type=bind,src=./img,dst=/app/out/img
)

mode="f"

while getopts "dfi" opt; do
  case ${opt} in
    *) mode=${opt} ;;
  esac
done

case ${mode} in
  d)
    docker run --rm "${DOCKER_MOUNTS[@]}" zmk-config draw -k cradio
    open img/cradio.svg
    ;;

  f)
    docker run --rm "${DOCKER_MOUNTS[@]}" zmk-config build -b nice_nano_v2 -s cradio_left
    docker run --rm "${DOCKER_MOUNTS[@]}" zmk-config build -b nice_nano_v2 -s cradio_right
    open firmware
    ;;

  i)
    docker build --tag zmk-config .
    ;;
esac
