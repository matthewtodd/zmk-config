#!/bin/bash

set -euo pipefail

usage() {
  cat <<-END
usage: build [-I] [-k <keyboard>] [<command>]

    -I             build docker image
    -k <keyboard>  select keyboard
                     ferris_sweep (default)
                     corne_min

  command is one of:
    firmware       build keyboard firmware (default)
    keymap         draw keyboard keymap
    shell          start an interactive shell in the docker container

END
}

docker_mounts=(
  --mount type=bind,src=./config,dst=/app/config,readonly
  --mount type=bind,src=./firmware,dst=/app/out/firmware,bind-create-src
  --mount type=bind,src=./img,dst=/app/out/img
)

while getopts "Ik:h" opt; do
  case ${opt} in
    I) docker build --tag zmk-config . ;;
    k) keyboard=${OPTARG} ;;
    h) usage; exit 0 ;;
   \?) usage; exit 1 ;;
  esac
done

case ${!OPTIND:-default} in
  firmware|default)
    case ${keyboard:-default} in
      ferris_sweep|default)
        docker run --rm "${docker_mounts[@]}" zmk-config build -b nice_nano_v2 -s cradio_left -a ferris_sweep-left
        docker run --rm "${docker_mounts[@]}" zmk-config build -b nice_nano_v2 -s cradio_right -a ferris_sweep-right
        ;;
      corne_min)
        docker run --rm "${docker_mounts[@]}" zmk-config build -b corne_min_left -s rgbled_adapter -a corne_min-left
        docker run --rm "${docker_mounts[@]}" zmk-config build -b corne_min_right -s rgbled_adapter -a corne_min-right
        ;;
      *)
        echo "${0}: unrecognized keyboard -- ${keyboard}"
        usage
        exit 1
        ;;
    esac

    open firmware
    ;;

  keymap)
    case ${keyboard:-default} in
      ferris_sweep|default)
        docker run --rm "${docker_mounts[@]}" zmk-config draw -k cradio
        open img/cradio.svg
        ;;
      corne_min)
        docker run --rm "${docker_mounts[@]}" zmk-config draw -k corne_min -d zmk/app/dts/layouts/foostan/corne/6column.dtsi
        open img/corne_min.svg
        ;;
      *)
        echo "${0}: unrecognized keyboard -- ${keyboard}"
        usage
        exit 1
        ;;
    esac
    ;;

  shell)
    docker run --rm "${docker_mounts[@]}" --name shell --entrypoint /bin/bash --interactive --tty zmk-config
    ;;

  *)
    echo "${0}: unrecognized command -- ${!OPTIND}"
    usage
    exit 1
    ;;

esac
