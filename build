#!/bin/bash

set -euo pipefail

usage() {
  cat <<-END
usage: build [ -f { corne_min | ferris_sweep } ]
       build [ -i | -d | -s ]

    -d             draw keymaps
    -f <keyboard>  build keyboard firmware
    -i             build docker image
    -s             get an interactive shell in the docker container

END
}

DOCKER_MOUNTS=(
  --mount type=bind,src=./config,dst=/app/config,readonly
  --mount type=bind,src=./firmware,dst=/app/out/firmware,bind-create-src
  --mount type=bind,src=./img,dst=/app/out/img
)

mode="f"

while getopts ":df:is" opt; do
  case ${opt} in
    f)
      mode=${opt}

      case ${OPTARG} in
        corne_min|ferris_sweep)
          keyboard=${OPTARG}
          ;;
        *) usage; exit 1 ;;
      esac
      ;;

    d|i|s)
      mode=${opt}
      ;;

    h) usage; exit ;;
    *) usage; exit 1 ;;
  esac
done

case ${mode} in
  d)
    docker run --rm "${DOCKER_MOUNTS[@]}" --name draw zmk-config draw -k corne_min -d zmk/app/dts/layouts/foostan/corne/6column.dtsi
    docker run --rm "${DOCKER_MOUNTS[@]}" --name draw zmk-config draw -k cradio
    open img/corne_min.svg
    open img/cradio.svg
    ;;

  f)
    if [ -z ${keyboard+x} ]; then
      select keyboard in corne_min ferris_sweep; do
        case "${REPLY}" in
          1|2) break ;;
          *) continue ;;
        esac
      done
    fi

    case ${keyboard} in
      corne_min)
        docker run --rm "${DOCKER_MOUNTS[@]}" --name build zmk-config build -b corne_min_left -s rgbled_adapter -a corne_min-left
        docker run --rm "${DOCKER_MOUNTS[@]}" --name build zmk-config build -b corne_min_right -s rgbled_adapter -a corne_min-right
        ;;
      ferris_sweep)
        docker run --rm "${DOCKER_MOUNTS[@]}" --name build zmk-config build -b nice_nano_v2 -s cradio_left -a ferris_sweep-left
        docker run --rm "${DOCKER_MOUNTS[@]}" --name build zmk-config build -b nice_nano_v2 -s cradio_right -a ferris_sweep-right
        ;;
    esac

    open firmware
    ;;

  i) docker build --tag zmk-config . ;;
  s) docker run --rm "${DOCKER_MOUNTS[@]}" --name shell --entrypoint /bin/bash -it zmk-config ;;
esac
